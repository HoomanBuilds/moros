# Public Supabase project URL, from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key, safe for the browser, from Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key, never expose to the browser, from Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# Separate server-only Supabase project for opaque private activity pages
PRIVATE_SYNC_SUPABASE_URL=
PRIVATE_SYNC_SUPABASE_SERVICE_ROLE_KEY=

# Canonical prediction app URL used in wallet sign-in challenges
NEXT_PUBLIC_SITE_URL=https://predict.moros.fun
NEXT_PUBLIC_PREDICT_URL=https://predict.moros.fun
NEXT_PUBLIC_PAY_URL=https://pay.moros.fun
NEXT_PUBLIC_BRAND_URL=https://moros.fun

# Change only this value and restart after both network profiles are configured.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_TESTNET_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_MAINNET_STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_TESTNET_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_MAINNET_STELLAR_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_TESTNET_PRIVATE_SERVICE_URL=https://your-testnet-private-service.example
NEXT_PUBLIC_MAINNET_PRIVATE_SERVICE_URL=

# Free Reflector mode works on both networks. Pyth Pro remains a paid switch.
NEXT_PUBLIC_ORACLE_MODE=free
