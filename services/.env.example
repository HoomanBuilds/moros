MOROS_NETWORK=testnet
MOROS_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
MOROS_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
MOROS_TESTNET_RPC_FALLBACK_URL=https://soroban-testnet.stellar.org
MOROS_MAINNET_RPC_FALLBACK_URL=https://mainnet.sorobanrpc.com
MOROS_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
MOROS_MAINNET_HORIZON_URL=https://horizon.stellar.org
MOROS_TESTNET_DEPLOYMENT=deployments/private-testnet.json
MOROS_MAINNET_DEPLOYMENT=deployments/private-mainnet.json
MOROS_TESTNET_ZK_PUBLIC_DIR=circuits/private-build/public
MOROS_MAINNET_ZK_PUBLIC_DIR=circuits/private-mainnet-build/public
MOROS_TESTNET_DEPLOYER_SK=
MOROS_MAINNET_DEPLOYER_SK=
MOROS_TESTNET_DEPLOYER_IDENTITY=
MOROS_MAINNET_DEPLOYER_IDENTITY=
MOROS_TESTNET_FUNDER_SK=
MOROS_MAINNET_FUNDER_SK=
MOROS_TESTNET_FUNDER_IDENTITY=
MOROS_MAINNET_FUNDER_IDENTITY=
MOROS_TESTNET_ROUNDING_FUNDER_SK=
MOROS_MAINNET_ROUNDING_FUNDER_SK=
MOROS_TESTNET_ROUNDING_FUNDER_IDENTITY=
MOROS_MAINNET_ROUNDING_FUNDER_IDENTITY=
MOROS_TESTNET_PRIVACY_SK=
MOROS_MAINNET_PRIVACY_SK=
MOROS_TESTNET_PRIVACY_IDENTITY=
MOROS_MAINNET_PRIVACY_IDENTITY=
SOURCE=deployer
DEPLOYER_SK=
ROUNDING_FUNDER_SK=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_SYNC_SUPABASE_URL=
PRIVATE_SYNC_SUPABASE_SERVICE_ROLE_KEY=
RESOLVE_INTERVAL_MS=300000
TTL_REFRESH_MS=604800000
KEEPER_STATUS_FILE=services/keeper-status.json
PRIVATE_PORT=8788
PRIVATE_TICK_MS=10000
PRIVATE_RELAY_LIMIT=20
PRIVATE_GLOBAL_RELAY_LIMIT=100
STELLAR_RPC_CLIENT_LIMIT=600
STELLAR_RPC_GLOBAL_LIMIT=1200
PUBLIC_ORIGINS=http://localhost:3000,https://moros.fun,https://www.moros.fun,https://moros-six.vercel.app
MOROS_TESTNET_DEPLOYMENT_NAME=Moros Testnet
MOROS_MAINNET_DEPLOYMENT_NAME=Moros Mainnet
MOROS_TESTNET_DEPLOYMENT_SALT=moros-testnet-release
MOROS_MAINNET_DEPLOYMENT_SALT=moros-mainnet-release
MOROS_TESTNET_ROUNDING_RESERVE=10000000
MOROS_MAINNET_ROUNDING_RESERVE=10000000

# Free Reflector mode is the default for testnet and mainnet.
ORACLE_MODE=free

# Optional future switch. This is read only when ORACLE_MODE=pyth_pro.
PYTH_PRO_RESOLVER_ID=
PYTH_ACCESS_TOKEN=
