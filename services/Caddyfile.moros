15-135-178-84.sslip.io {
	encode gzip
	respond 404
}

moros-market.duckdns.org {
	encode gzip

	handle_path /payments/* {
		reverse_proxy localhost:8791
	}

	handle_path /payments-testnet/* {
		reverse_proxy localhost:8790
	}

	handle /stellar/rpc {
		reverse_proxy localhost:8788
	}

	handle {
		respond 404
	}
}

pay.moros.fun {
	encode gzip
	reverse_proxy localhost:3001
}
